<launch>
    <!--
        Stage 1 warehouse integration:
        prove ROS navigation + pickup/drop first.
        Avoidance stays off by default until sensor validation.
    -->
    <arg
        name="enable_obstacle_avoidance"
        default="false"
    />

    <include file="$(find drone_sorting)/launch/drone_demo.launch">
        <arg
            name="enable_obstacle_avoidance"
            value="$(arg enable_obstacle_avoidance)"
        />

        <!-- Unity (x,y,z) -> ROS (x,z,y) -->
        <!-- Package Unity position ~= (34.23, 0.44, 25.10) -->
        <!-- Pickup detector/mount sits 0.95 m below drone root. -->
        <arg name="pickup_x" value="34.23" />
        <arg name="pickup_y" value="25.10" />
        <arg name="pickup_z" value="1.39" />

        <!-- Existing successful DeliveryDemo releases at Unity (28, 1, 55). -->
        <!-- Package mount is 0.95 m below the drone root. -->
        <arg name="dropoff_x" value="28.00" />
        <arg name="dropoff_y" value="55.00" />
        <arg name="dropoff_z" value="1.95" />

        <!-- Tighter than PackageHandling pickupRadius = 0.22 m. -->
        <arg name="arrival_tolerance" value="0.05" />
    </include>
</launch>
