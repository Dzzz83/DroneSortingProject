<launch>
    <!-- Pickup-only starts at observation; delivery can include access from DroneStart. -->
    <arg name="enable_delivery" default="false" />
    <arg name="start_from_drone_start" default="false" />
    <include file="$(find drone_sorting)/launch/package_perception.launch" />
    <node pkg="drone_sorting" type="camera_pickup_node.py" name="camera_pickup" output="screen">
        <param name="enable_delivery" value="$(arg enable_delivery)" />
        <param name="start_from_drone_start" value="$(arg start_from_drone_start)" />
        <!-- Warehouse ROS coordinates; Z heights refer to drone root. -->
        <param name="observation_x" value="34.0" />
        <param name="observation_y" value="25.0" />
        <param name="observation_height" value="6.0" />
        <param name="access_speed" value="0.5" />
        <param name="access_timeout" value="60.0" />
        <param name="hover_time" value="1.0" />
        <param name="dropoff_x" value="38.0" />
        <param name="dropoff_y" value="55.0" />
        <param name="carry_height" value="6.0" />
        <param name="release_height" value="1.4" />
        <param name="carry_speed" value="0.5" />
        <param name="lowering_speed" value="0.2" />
        <param name="travel_timeout" value="120.0" />
        <param name="drop_timeout" value="5.0" />
        <param name="settle_time" value="2.0" />
    </node>
    <node pkg="drone_sorting" type="motion_controller_node.py" name="motion_controller" output="screen">
        <param name="enable_obstacle_avoidance" value="false" />
        <param name="speed" value="0.5" />
        <param name="enable_dynamic_speed" value="true" />
        <param name="position_timeout" value="0.5" />
        <param name="target_timeout" value="0.5" />
        <param name="speed_timeout" value="0.5" />
    </node>
</launch>
